# ============================================================
# .gitignore — 578-EHRM-TrainingSchedulerApp
# Last updated: 2026-07-28
# ============================================================

# ============================================================
# CONFIRMED LOCAL-ONLY / SENSITIVE DIRECTORIES
# Everything listed below is intentionally NEVER committed.
# ============================================================

# ------------------------------------------------------------
# 1. Temporary / scratch / export directories (local-only)
# ------------------------------------------------------------
/tmp/
/dist/
/archive/

# ------------------------------------------------------------
# 2. Developer-only / local docs & logs
# ------------------------------------------------------------
/docs/local/
/docs/logs/
/docs/release-notes/releaseTemplates/
!/assets/screenshots/
/optionalGUI/

# ------------------------------------------------------------
# 3. Config folder (local-only; contains runbooks, environment
#    templates, tooling helpers, and sensitive config values).
#    RESOLVED (v0.3.8): the 3 files formerly tracked under
#    config/ (ARCHITECTURE.md, ALM-RUNBOOK.md, alm.ps1) have
#    been untracked via `git rm --cached -r config/` and the
#    local folder relocated to archive/src/config/.
# ------------------------------------------------------------
/config/
/src/config/local/

# ------------------------------------------------------------
# 4. Git internals
#    .git/ is always protected by Git itself — this entry is
#    explicit for documentation/clarity purposes only.
# ------------------------------------------------------------
/.git/

# ------------------------------------------------------------
# 5. Secrets and environment-specific values
# ------------------------------------------------------------
*.env
*.env.*
.secrets/
secrets.*
credentials.*

# ------------------------------------------------------------
# 6. OS / editor generated files
# ------------------------------------------------------------
.vs/
.DS_Store
Thumbs.db
desktop.ini
~$*

# ------------------------------------------------------------
# 7. Dependencies & build artifacts
# ------------------------------------------------------------
node_modules/
coverage/
__pycache__/
*.pyc
*.pyo

# ------------------------------------------------------------
# 8. Backup, log, and swap files
# ------------------------------------------------------------
**/*.bak
**/*.log
*.tmp
*.swp
*.swo

# ------------------------------------------------------------
# 9. Power Platform — binary exports & compressed archives
#
#    .zip / compressed formats are always ignored to prevent
#    large binary exports from entering the repo accidentally.
#    .msapp is excluded from the zip rule (pac canvas output
#    that lives under dist/, which is already ignored anyway).
#    .pbit (Power BI template) is excluded from the pbix rule.
#
#    To expose a specific public-facing file, add a negation
#    directly below this block, e.g.:
#      !docs/some-sanitized-file.zip
# ------------------------------------------------------------

# Canvas app packages and solution exports
*.zip
!*.msapp
src/**/.zip/**

# Compressed archive formats
**/*.7z
**/*.gz
**/*.bz2
**/*.tar
**/*.tgz
**/*.tar.gz
**/*.tar.bz2
**/*.rar

# Power BI binary (ignore large binary; allow templates)
*.pbix
!*.pbit

# ------------------------------------------------------------
# 10. Spreadsheet / data list files
#
#     Ignored broadly to prevent PII or sensitive VA data from
#     being committed accidentally.
#
#     RESOLVED (v0.3.8): the sanitized CSVs formerly tracked
#     under src/sharePoint/ have been untracked via
#     `git rm --cached -r src/sharePoint/`. Raw list exports now
#     live under src/sharePoint/list/<listName>/local/ (fully
#     covered by both this extension rule and §11 below). To
#     un-ignore a specific public-facing file, add a line, e.g.:
#       !src/sharePoint/list/desks/local/Desks.csv
#     ...then `git add -f` that file.
# ------------------------------------------------------------
**/*.csv
**/*.tsv
**/*.xlsx
**/*.xls
**/*.xlsm
**/*.xlsb
**/*.ods

# ------------------------------------------------------------
# 11. Local-only working directories (any folder literally named
#     "local" anywhere in the repo).
#
#     Generalizes the folder-based rule already used for
#     /docs/local/ and /src/config/local/ to also cover newer
#     local-only locations introduced in v0.3.8, e.g.:
#       assets/local/                    (raw screen recordings)
#       src/analytics/sql/local/
#       src/analytics/powerBI/local/
#       src/sharePoint/list/*/local/     (raw list export CSV/XLSX)
#
#     The extension-based rules above (§9, §10) already ignore
#     most data/archive formats regardless of folder; this rule
#     adds folder-level protection for any other file type (e.g.,
#     .webm screen recordings) dropped into a "local" folder.
# ------------------------------------------------------------
**/local/
