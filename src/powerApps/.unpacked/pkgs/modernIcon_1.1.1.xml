<widget xmlns="http://openajax.org/metadata" xmlns:appMagic="http://schemas.microsoft.com/appMagic" spec="1.0" id="http://microsoft.com/appmagic/modernIcon" name="modernIcon" jsClass="AppMagic.Controls.ModernIconControl" version="1.1.1" styleable="true" runtimeCost="1" enabledForFeatureGate="Controls.ModernIconControl">
  <author name="Microsoft AppMagic" />
  <license type="text/html"><![CDATA[<p>Copyright (C) Microsoft Corporation. All rights reserved.</p>]]></license>
  <description><![CDATA[Modern icon control using Fluent UI v9 icons. Displays a Fluent icon by name with configurable style, color, and rotation.]]></description>
  <requires>
    <require type="javascript" src="/openSource/modified/pcfplatformlibs/fluent_9_4_0.js" />
    <require type="javascript" src="/ctrllib/shared/js/PowerAppsControlsFluentIcons.js" />
    <require type="javascript" src="js/modernIcon.js" />
  </requires>
  <appMagic:capabilities contextualViewsEnabled="true" autoDisabledViewState="true" isVersionFlexible="true" />
  <appMagic:accessibilityChecks controlIsInteractive="true" />
  <content><![CDATA[]]></content>
  <properties>
    <!-- Icon-specific custom properties -->
    <property name="Icon" localizedName="##icon_Icon##" datatype="String" defaultValue="&quot;Add&quot;" isExpr="true" direction="in" showInFloatie="true" showInCommandBar="true">
      <title>Icon</title>
      <appMagic:category>data</appMagic:category>
      <appMagic:displayName>##icon_Icon_DisplayName##</appMagic:displayName>
      <appMagic:tooltip>##icon_Icon_Tooltip##</appMagic:tooltip>
    </property>
    <property name="IconStyle" localizedName="##icon_IconStyle##" datatype="IconStyle" defaultValue="%IconStyle.RESERVED%.Outline" isExpr="true" direction="in">
      <title>Icon style</title>
      <appMagic:category>design</appMagic:category>
      <appMagic:displayName>##icon_IconStyle_DisplayName##</appMagic:displayName>
      <appMagic:tooltip>##icon_IconStyle_Tooltip##</appMagic:tooltip>
    </property>
    <property name="Rotation" localizedName="##icon_Rotation##" datatype="Number" defaultValue="0" isExpr="true" direction="in">
      <title>Rotation</title>
      <appMagic:category>design</appMagic:category>
      <appMagic:displayName>##icon_Rotation_DisplayName##</appMagic:displayName>
      <appMagic:tooltip>##icon_Rotation_Tooltip##</appMagic:tooltip>
    </property>
    <property name="IconColor" localizedName="##icon_IconColor##" datatype="Color" defaultValue="" isExpr="true" direction="in" isResettableToManifestDefault="true" isLinkableToParentTheme="true" converter="argbConverter">
      <title>Icon color</title>
      <appMagic:category>design</appMagic:category>
      <appMagic:helperUI>color</appMagic:helperUI>
      <appMagic:displayName>##icon_IconColor_DisplayName##</appMagic:displayName>
      <appMagic:tooltip>##icon_IconColor_Tooltip##</appMagic:tooltip>
    </property>
  </properties>
  <appMagic:includeProperties>
    <!-- Data -->
    <appMagic:includeProperty name="ContentLanguage" />
    <appMagic:includeProperty name="DisplayMode" />
    <appMagic:includeProperty name="OnSelect" direction="in" isPrimaryBehaviorProperty="true" isPrimaryInputProperty="true" />
    <!-- Design - Color Palette -->
    <appMagic:includeProperty name="BasePaletteColor" isResettableToManifestDefault="true" isLinkableToParentTheme="true" />
    <!-- Design - Fill and Border -->
    <appMagic:includeProperty name="Fill" defaultValue="" isExpr="true" isResettableToManifestDefault="true" isLinkableToParentTheme="true" />
    <appMagic:includeProperty name="BorderColor" defaultValue="" isExpr="true" />
    <appMagic:includeProperty name="BorderStyle" defaultValue="" isExpr="false" />
    <appMagic:includeProperty name="BorderThickness" defaultValue="" nullDefault="" isExpr="true" />
    <!-- Design - Padding -->
    <appMagic:includeProperty name="PaddingTop" defaultValue="0" nullDefault="" isExpr="true" />
    <appMagic:includeProperty name="PaddingRight" defaultValue="0" nullDefault="" isExpr="true" />
    <appMagic:includeProperty name="PaddingBottom" defaultValue="0" nullDefault="" isExpr="true" />
    <appMagic:includeProperty name="PaddingLeft" defaultValue="0" nullDefault="" isExpr="true" />
    <!-- Design - Radius -->
    <appMagic:includeProperty name="RadiusTopLeft" defaultValue="" nullDefault="" isExpr="true" isResettableToManifestDefault="true" isLinkableToParentTheme="true" />
    <appMagic:includeProperty name="RadiusTopRight" defaultValue="" nullDefault="" isExpr="true" isResettableToManifestDefault="true" isLinkableToParentTheme="true" />
    <appMagic:includeProperty name="RadiusBottomLeft" defaultValue="" nullDefault="" isExpr="true" isResettableToManifestDefault="true" isLinkableToParentTheme="true" />
    <appMagic:includeProperty name="RadiusBottomRight" defaultValue="" nullDefault="" isExpr="true" isResettableToManifestDefault="true" isLinkableToParentTheme="true" />
    <!-- Position and Size -->
    <appMagic:includeProperty name="X" />
    <appMagic:includeProperty name="Y" />
    <appMagic:includeProperty name="Width" defaultValue="32" phoneDefaultValue="42" webDefaultValue="32" />
    <appMagic:includeProperty name="Height" defaultValue="32" phoneDefaultValue="42" webDefaultValue="32" />
    <appMagic:includeProperty name="Visible" />
    <!-- Accessibility -->
    <appMagic:includeProperty name="AccessibleLabel" />
    <!-- Tooltip -->
    <appMagic:includeProperty name="Tooltip" />
    <!-- Hidden properties -->
    <appMagic:includeProperty name="maximumHeight" defaultValue="768" />
    <appMagic:includeProperty name="maximumWidth" defaultValue="1366" />
    <appMagic:includeProperty name="minimumHeight" defaultValue="10" />
    <appMagic:includeProperty name="minimumWidth" defaultValue="10" />
  </appMagic:includeProperties>
  <!-- Property Dependencies -->
  <appMagic:propertyDependencies />
  <appMagic:insertMetadata>
    <appMagic:category name="Display" priority="10" />
  </appMagic:insertMetadata>
  <!-- Display metadata providing property visibility, order, sections, and grouping in UI -->
  <appMagic:displayMetadata>
    <!-- General section -->
    <appMagic:section type="GeneralSection">
      <appMagic:property name="Icon" displayType="FluentIcon" />
      <appMagic:property name="AccessibleLabel" />
    </appMagic:section>
    <!-- Behavior section -->
    <appMagic:section type="BehaviorSection">
      <appMagic:property name="DisplayMode" />
      <appMagic:property name="Visible" />
    </appMagic:section>
    <!-- Size and Position section -->
    <appMagic:section type="SizeAndPositioningSection">
      <appMagic:property name="Rotation" />
      <appMagic:propertyGroup name="Position">
        <appMagic:property name="X" />
        <appMagic:property name="Y" />
      </appMagic:propertyGroup>
      <appMagic:propertyGroup name="Size">
        <appMagic:property name="Width" />
        <appMagic:property name="Height" />
      </appMagic:propertyGroup>
      <appMagic:propertyGroup name="Padding">
        <appMagic:property name="PaddingTop" labelOverride="##Padding_Top_Title##" />
        <appMagic:property name="PaddingRight" labelOverride="##Padding_Right_Title##" />
        <appMagic:property name="PaddingBottom" labelOverride="##Padding_Bottom_Title##" />
        <appMagic:property name="PaddingLeft" labelOverride="##Padding_Left_Title##" />
      </appMagic:propertyGroup>
    </appMagic:section>
    <!-- Style and Theme section -->
    <appMagic:section type="StyleAndThemeSection">
      <appMagic:property name="IconColor" showInFloatie="true" showInCommandBar="true" />
      <appMagic:property name="IconStyle" />
      <appMagic:property name="Fill" showInFloatie="true" showInCommandBar="true" />
      <appMagic:propertyGroup name="Border">
        <appMagic:property name="BorderStyle" />
        <appMagic:property name="BorderThickness" />
        <appMagic:property name="BorderColor" />
      </appMagic:propertyGroup>
      <appMagic:propertyGroup name="Radius">
        <appMagic:property name="RadiusTopLeft" labelOverride="##Radius_TopLeft_Title##" />
        <appMagic:property name="RadiusTopRight" labelOverride="##Radius_TopRight_Title##" />
        <appMagic:property name="RadiusBottomLeft" labelOverride="##Radius_BottomLeft_Title##" />
        <appMagic:property name="RadiusBottomRight" labelOverride="##Radius_BottomRight_Title##" />
      </appMagic:propertyGroup>
    </appMagic:section>
  </appMagic:displayMetadata>
  <appMagic:conversion from="1.0.0" to="1.1.0">
    <appMagic:conversionAction type="add" name="Tooltip" />
  </appMagic:conversion>
  <appMagic:conversion from="1.1.0" to="1.1.1">
    <!-- Metadata update: add isResettableToManifestDefault and isLinkableToParentTheme attributes to BasePaletteColor -->
  </appMagic:conversion>
</widget>